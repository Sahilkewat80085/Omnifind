# Copy this file to .env and adjust as needed.

# --- App ---
APP_NAME=OmniFind
APP_ENV=development
LOG_LEVEL=INFO

# --- SQLite ---
DATABASE_URL=sqlite:///./storage/omnifind.db

# --- Qdrant ---
# mode=local runs embedded on-disk (no server needed). mode=server connects
# to a Qdrant instance you run yourself at QDRANT_HOST:QDRANT_PORT.
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./storage/qdrant_local
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=omnifind_assets

# --- Embedding models ---
TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
IMAGE_EMBEDDING_MODEL=ViT-B-32
IMAGE_EMBEDDING_PRETRAINED=laion2b_s34b_b79k

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Search ---
SEARCH_TOP_K=10

# --- LLM / RAG (Milestone 2) ---
# Get a key at https://aistudio.google.com/apikey
# Leave blank to run search-only: the app still boots, but /ask returns a
# clear "not configured" error instead of an answer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024

# How many retrieved chunks are sent to the model as context.
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.15

# How many matching images the Ask page shows beside an answer. These are
# scored by CLIP and never enter the prompt, so RAG_MIN_SIMILARITY (a bge-scale
# threshold) does not apply to them — SEARCH_IMAGE_SCORE_FLOOR does.
RAG_IMAGE_TOP_K=4
