# Copy this file to .env and adjust as needed.

# --- App ---
APP_NAME=OmniFind
APP_ENV=development
LOG_LEVEL=INFO

# --- SQLite ---
DATABASE_URL=sqlite:///./storage/omnifind.db

# --- Qdrant ---
# mode=local runs embedded on-disk (no server needed). mode=server connects
# to a Qdrant instance you run yourself at QDRANT_HOST:QDRANT_PORT.
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./storage/qdrant_local
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=omnifind_assets

# --- Embedding models ---
TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
IMAGE_EMBEDDING_MODEL=ViT-B-32
IMAGE_EMBEDDING_PRETRAINED=laion2b_s34b_b79k

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Search ---
SEARCH_TOP_K=10
